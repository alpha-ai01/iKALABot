#!/usr/bin/env python3
"""
Simple import path fixer for common moves:
- handlers.text -> handlers.message_handler
- main_polling_bot -> plugins.main_polling_bot
Add mappings as needed.

This script edits files in-place and creates .bak backups.
"""
from pathlib import Path

# การแมปจาก string เก่า -> ใหม่
REPLACEMENTS = {
    "from handlers.text": "from handlers.message_handler",
    "import handlers.text": "import handlers.message_handler",
    "from main_polling_bot": "from plugins.main_polling_bot",
    "import main_polling_bot": "import plugins.main_polling_bot",
    # เพิ่ม mappings อื่น ๆ ที่ต้องการ
}

# ไฟล์ที่จะสแกน
ROOT = Path(".")
py_files = [p for p in ROOT.rglob("*.py") if ".venv" not in p.parts and ".git" not in p.parts and "plugins/legacy" not in str(p)]

changed_files = []

for p in py_files:
    try:
        text = p.read_text(encoding="utf8")
    except Exception:
        continue
    new_text = text
    for old, new in REPLACEMENTS.items():
        if old in new_text:
            new_text = new_text.replace(old, new)
    if new_text != text:
        bak = p.with_suffix(p.suffix + ".bak")
        bak.write_text(text, encoding="utf8")
        p.write_text(new_text, encoding="utf8")
        changed_files.append(str(p))
        print(f"Updated imports in: {p} (backup: {bak})")

print(f"Total files changed: {len(changed_files)}")
if changed_files:
    print("Please run tests and manually verify complex imports/static analysis (flake8/mypy).")
